#!/usr/bin/env sh
set -u

cd "$(dirname "$0")/.."

usage() {
  printf 'Usage: scripts/release-tag <version> [message]\n'
  printf 'Example: scripts/release-tag v0.2.0-rc1 "Release 0.2.0 RC1"\n'
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

version="${1:-}"
message="${2:-Release $version}"

if [ -z "$version" ]; then
  usage >&2
  exit 1
fi

case "$version" in
  v[0-9]*.[0-9]*.[0-9]*|v[0-9]*.[0-9]*.[0-9]*-alpha[0-9]*|v[0-9]*.[0-9]*.[0-9]*-beta[0-9]*|v[0-9]*.[0-9]*.[0-9]*-rc[0-9]*) ;;
  *)
    printf 'Invalid version "%s". Use vMAJOR.MINOR.PATCH, vMAJOR.MINOR.PATCH-alphaN, vMAJOR.MINOR.PATCH-betaN, or vMAJOR.MINOR.PATCH-rcN.\n' "$version" >&2
    exit 1
    ;;
esac

if git rev-parse "$version" >/dev/null 2>&1; then
  printf 'Release tag already exists: %s\n' "$version" >&2
  exit 1
fi

if ! ./scripts/release-readiness; then
  exit 1
fi

git tag -a "$version" -m "$message"
printf 'Created release tag %s\n' "$version"
printf 'Push with: git push origin %s\n' "$version"
